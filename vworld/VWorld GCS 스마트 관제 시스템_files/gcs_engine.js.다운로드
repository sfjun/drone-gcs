        // 0m 이하로 파괴되는 현상을 막기 위한 난곡동 타겟 물리 범위 스냅 가드 (순정 보정 유지)
        if (finalCalculatedHeight <= 5 || finalCalculatedHeight > 2000) {
            finalCalculatedHeight = (wp.id === "Home") ? 110 : 90; 
