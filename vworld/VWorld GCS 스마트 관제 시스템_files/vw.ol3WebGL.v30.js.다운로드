        _getTimeStringhtml: function (min) {
               var h = parseInt(min / 60);
               var m = parseInt(min % 60);
               if (h != 0 && m != 0) {
                   return "<strong class='num'>" + h + "</strong>시간<strong class='num'> " + m + "</strong>분";
               } else if (h != 0 && m == 0) {
                   return "<strong class='num'>" + h + "</strong>시간 ";
               } else if (h == 0 && m != 0) {
                   return "<strong class='num'>" + m + "</strong>분";
               } else {
                   return "<strong class='num'>1</strong>분 미만";
               }
           },
           _getTimeString:  function (min) {
               var h = parseInt(min / 60);
               var m = parseInt(min % 60);
               if (h != 0 && m != 0) {
                   return h + "시간 " + m + "분";
               } else if (h != 0 && m == 0) {
                   return h + "시간 ";
               } else if (h == 0 && m != 0) {
                   return m + "분";
               } else {
                   return "1분 미만";
               }
           },
           _commify: function (n) {
               var reg = /(^[+-]?\d+)(\d{3})/;
               n += '';
               while (reg.test(n))
                   n = n.replace(reg, '$1' + ',' + '$2');
               return n;
           },
           _sleep: function (ms){
   			var start = new Date().getTime();
   			for (var i = 0; i < 1e7; i++) {
   			    if ((new Date().getTime() - start) > ms){
   			      break;
   			    }
   			}
   		},
        _loadExtLibs: function (UrlArray, afterFunc) {
            var srcUrl = '',
                afterUrl = '';
            var remainUrls = UrlArray;
            if (remainUrls != null && remainUrls.length > 0) {
                srcUrl = remainUrls.shift();
            }
            if (srcUrl != '') {
                if (remainUrls.length > 0) {
                    afterUrl = remainUrls[0];
                }
                var js = this._createElement('script');
                js.setAttribute('type', "text/javascript");
                js.setAttribute('src', srcUrl);
                js.setAttribute('async', false);
                js.onreadystatechange = function () {
                    if (js.readyState == 'loaded' || js.readyState == 'complete') {
                        if (afterUrl != '') {
                            js.onreadystatechange = null;
                            vw.ol3.CommonFunc._loadExtLibs(remainUrls, afterFunc);
                        } else {
                            afterFunc();
                        }
                    }
                }
                js.onload = function () {
                    if (afterUrl != '') {
                        js.onload = null;
                        vw.ol3.CommonFunc._loadExtLibs(remainUrls, afterFunc);
                    } else {
                        afterFunc();
                    }
                }
                document.getElementsByTagName('head')[0].appendChild(js);
            }
            return false;
        },
        _ShimResize: function (type) {
            if ((vw.ol3.CommonFunc._getElement(vw.vworldIDs.idmenu) == null) || (vw.ol3.CommonFunc._getElement(vw.vworldIDs.idmenu) == null)) return false;
